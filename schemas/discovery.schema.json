{
  "$defs": {
    "Business": {
      "additionalProperties": false,
      "properties": {
        "internal_id": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Internal Id",
          "type": "string"
        },
        "legal_name": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Legal Name",
          "type": "string"
        },
        "trading_name": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trading Name"
        },
        "address": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address"
        },
        "postal_code": {
          "anyOf": [
            {
              "pattern": "^\\d{5}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Postal Code"
        },
        "city": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "City"
        },
        "country": {
          "const": "FR",
          "default": "FR",
          "title": "Country",
          "type": "string"
        },
        "latitude": {
          "anyOf": [
            {
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latitude"
        },
        "longitude": {
          "anyOf": [
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Longitude"
        },
        "official_identifiers": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Official Identifiers",
          "type": "object"
        },
        "website": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Website"
        },
        "phone": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phone"
        },
        "professional_email": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Professional Email"
        },
        "activity_code": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activity Code"
        },
        "source_references": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "title": "Source References",
          "type": "array"
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/SourceObservation"
          },
          "title": "Observations",
          "type": "array"
        },
        "contact_policy": {
          "$ref": "#/$defs/ContactPolicy"
        }
      },
      "required": [
        "internal_id",
        "legal_name",
        "contact_policy"
      ],
      "title": "Business",
      "type": "object"
    },
    "ContactPolicy": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "collected_at": {
          "format": "date-time",
          "title": "Collected At",
          "type": "string"
        },
        "purpose": {
          "const": "business_discovery_and_qualification",
          "default": "business_discovery_and_qualification",
          "title": "Purpose",
          "type": "string"
        },
        "contact_type": {
          "default": "none",
          "enum": [
            "none",
            "public_business_contact"
          ],
          "title": "Contact Type",
          "type": "string"
        },
        "deleted_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deleted At"
        },
        "do_not_contact": {
          "default": true,
          "title": "Do Not Contact",
          "type": "boolean"
        }
      },
      "required": [
        "source",
        "collected_at"
      ],
      "title": "ContactPolicy",
      "type": "object"
    },
    "EnrichmentRun": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "collected_at": {
          "format": "date-time",
          "title": "Collected At",
          "type": "string"
        },
        "status": {
          "enum": [
            "no_website",
            "skipped",
            "ok",
            "partial",
            "inaccessible",
            "blocked"
          ],
          "title": "Status",
          "type": "string"
        },
        "pages": {
          "items": {
            "$ref": "#/$defs/PageSummary"
          },
          "title": "Pages",
          "type": "array"
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/SourceObservation"
          },
          "title": "Observations",
          "type": "array"
        },
        "signals": {
          "items": {
            "$ref": "#/$defs/Signal"
          },
          "title": "Signals",
          "type": "array"
        },
        "errors": {
          "items": {
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        }
      },
      "required": [
        "collected_at",
        "status"
      ],
      "title": "EnrichmentRun",
      "type": "object"
    },
    "JsonValue": {},
    "Opportunity": {
      "enum": [
        "website",
        "ai",
        "cybersecurity"
      ],
      "title": "Opportunity",
      "type": "string"
    },
    "PageSummary": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "status_code": {
          "title": "Status Code",
          "type": "integer"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "response_ms": {
          "minimum": 0,
          "title": "Response Ms",
          "type": "integer"
        },
        "redirects": {
          "items": {
            "type": "string"
          },
          "title": "Redirects",
          "type": "array"
        }
      },
      "required": [
        "url",
        "status_code",
        "response_ms"
      ],
      "title": "PageSummary",
      "type": "object"
    },
    "Qualification": {
      "additionalProperties": false,
      "properties": {
        "business": {
          "$ref": "#/$defs/Business"
        },
        "enrichment": {
          "$ref": "#/$defs/EnrichmentRun"
        },
        "scores": {
          "$ref": "#/$defs/Scores"
        }
      },
      "required": [
        "business",
        "enrichment",
        "scores"
      ],
      "title": "Qualification",
      "type": "object"
    },
    "Score": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "maximum": 100,
          "minimum": 0,
          "title": "Value",
          "type": "integer"
        },
        "interpretation": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Interpretation",
          "type": "string"
        },
        "reasons": {
          "items": {
            "$ref": "#/$defs/ScoreReason"
          },
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "value",
        "interpretation"
      ],
      "title": "Score",
      "type": "object"
    },
    "ScoreReason": {
      "additionalProperties": false,
      "properties": {
        "signal": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Signal",
          "type": "string"
        },
        "weight": {
          "maximum": 100,
          "minimum": 0,
          "title": "Weight",
          "type": "integer"
        },
        "evidence": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "observation_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Observation Ids",
          "type": "array"
        }
      },
      "required": [
        "signal",
        "weight",
        "evidence",
        "observation_ids"
      ],
      "title": "ScoreReason",
      "type": "object"
    },
    "Scores": {
      "additionalProperties": false,
      "properties": {
        "website_opportunity_score": {
          "anyOf": [
            {
              "$ref": "#/$defs/Score"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ai_automation_opportunity_score": {
          "anyOf": [
            {
              "$ref": "#/$defs/Score"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cybersecurity_opportunity_score": {
          "anyOf": [
            {
              "$ref": "#/$defs/Score"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "data_confidence_score": {
          "$ref": "#/$defs/Score"
        }
      },
      "required": [
        "data_confidence_score"
      ],
      "title": "Scores",
      "type": "object"
    },
    "SearchQuery": {
      "additionalProperties": false,
      "properties": {
        "activity": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Activity",
          "type": "string"
        },
        "location": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Location",
          "type": "string"
        },
        "requested_opportunities": {
          "items": {
            "$ref": "#/$defs/Opportunity"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Requested Opportunities",
          "type": "array"
        },
        "limit": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "required": [
        "activity",
        "location"
      ],
      "title": "SearchQuery",
      "type": "object"
    },
    "Signal": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        },
        "observation_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Observation Ids",
          "type": "array"
        }
      },
      "required": [
        "name",
        "value",
        "observation_ids"
      ],
      "title": "Signal",
      "type": "object"
    },
    "SourceObservation": {
      "additionalProperties": false,
      "properties": {
        "source_name": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Source Name",
          "type": "string"
        },
        "source_url": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "collected_at": {
          "format": "date-time",
          "title": "Collected At",
          "type": "string"
        },
        "id": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "field": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "raw_value": {
          "$ref": "#/$defs/JsonValue"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "source_name",
        "source_url",
        "collected_at",
        "id",
        "field",
        "raw_value",
        "value",
        "confidence"
      ],
      "title": "SourceObservation",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "source_name": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Source Name",
          "type": "string"
        },
        "source_url": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "collected_at": {
          "format": "date-time",
          "title": "Collected At",
          "type": "string"
        }
      },
      "required": [
        "source_name",
        "source_url",
        "collected_at"
      ],
      "title": "SourceReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scoring_policy_version": {
      "const": "conservative-v1",
      "default": "conservative-v1",
      "title": "Scoring Policy Version",
      "type": "string"
    },
    "search_id": {
      "title": "Search Id",
      "type": "string"
    },
    "query": {
      "$ref": "#/$defs/SearchQuery"
    },
    "collected_at": {
      "format": "date-time",
      "title": "Collected At",
      "type": "string"
    },
    "source_mode": {
      "enum": [
        "official_api",
        "synthetic_demo"
      ],
      "title": "Source Mode",
      "type": "string"
    },
    "qualifications": {
      "items": {
        "$ref": "#/$defs/Qualification"
      },
      "title": "Qualifications",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "query",
    "collected_at",
    "source_mode",
    "qualifications"
  ],
  "title": "DiscoveryResult",
  "type": "object"
}
