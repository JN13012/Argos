{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Argos Core offline assessment v1",
  "description": "Structural schema. Argos additionally checks unique IDs, references, scope membership, text controls, contained paths, file sizes and evidence hashes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mission", "evidence", "findings"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "mission": {"$ref": "#/$defs/mission"},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 4000, "pattern": "\\S"},
    "shortText": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"},
    "mission": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "description", "scope"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"$ref": "#/$defs/shortText"},
        "description": {"$ref": "#/$defs/text"},
        "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/shortText"}}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "path", "sha256", "description", "source"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "path": {"type": "string", "minLength": 1, "maxLength": 512},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "description": {"$ref": "#/$defs/text"},
        "source": {"$ref": "#/$defs/text"}
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["decision", "reviewer", "reason"],
      "properties": {
        "decision": {"enum": ["accepted", "rejected"]},
        "reviewer": {"$ref": "#/$defs/shortText"},
        "reason": {"$ref": "#/$defs/text"}
      }
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "severity", "asset", "description", "recommendation", "evidence_ids", "review"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"$ref": "#/$defs/shortText"},
        "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
        "asset": {"$ref": "#/$defs/shortText"},
        "description": {"$ref": "#/$defs/text"},
        "recommendation": {"$ref": "#/$defs/text"},
        "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "review": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/review"}]}
      }
    }
  }
}
