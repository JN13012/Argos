<%- include("partials/head") %>
<h1>Profile</h1>
<dl class="wide">
  <dt>Name</dt><dd><%= customer.full_name %></dd>
  <dt>Email</dt><dd class="mono"><%= customer.email %></dd>
  <dt>Role</dt><dd><%= customer.role %></dd>
  <% if (customer.organisation) { %><dt>Organisation</dt><dd><%= customer.organisation %></dd><% } %>
  <dt>Identity check</dt><dd><%= customer.kyc_status %></dd>
  <dt>Accounts</dt><dd><%= accounts %></dd>
</dl>
<p class="muted small">
  <a href="/documents">Documents</a> &middot;
  <a href="/payees">Payees</a> &middot;
  <a href="/signout">Sign out</a>
</p>
<%- include("partials/foot") %>
