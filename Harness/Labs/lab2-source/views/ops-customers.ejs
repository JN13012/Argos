<%- include("partials/head") %>
<h1>Customers</h1>
<table><thead><tr><th>ID</th><th>Name</th><th>Email</th><th>Role</th><th>Organisation</th><th class="r">Accounts</th><th>KYC</th></tr></thead><tbody>
<% customers.forEach(c => { %>
  <tr><td class="mono"><%= c.id %></td><td><%= c.full_name %></td>
  <td class="mono small"><%= c.email %></td><td><%= c.role %></td>
  <td class="small"><%= c.organisation || '' %></td>
  <td class="r"><%= c.accounts %></td><td><%= c.kyc_status %></td></tr>
<% }) %>
</tbody></table>
<%- include("partials/foot") %>
