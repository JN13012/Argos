<%- include("partials/head") %>
<h1>Move money</h1>
<div class="cols">
<section>
  <h2>Between your accounts</h2>
  <p class="muted small">Instant. Both accounts must be in the same currency.</p>
  <form data-api="/api/transfers/internal" data-result="#r-internal" data-reload-on-success>
    <label>From<select name="from_account_id">
      <% accounts.forEach(a => { %><option value="<%= a.id %>"><%= a.kind %> <%= a.account_number %> (<%= a.currency %>)</option><% }) %>
    </select></label>
    <label>To<select name="to_account_id">
      <% accounts.forEach(a => { %><option value="<%= a.id %>"><%= a.kind %> <%= a.account_number %> (<%= a.currency %>)</option><% }) %>
    </select></label>
    <label>Amount<input type="text" name="amount" placeholder="50.00" required></label>
    <label>Reference<input type="text" name="narrative" maxlength="140" placeholder="optional"></label>
    <button type="submit">Transfer</button>
  </form>
  <pre id="r-internal" class="result" hidden></pre>
</section>
<section>
  <h2>To another bank</h2>
  <p class="muted small">
    Sent on the faster payments rail. Shows as pending until the next
    settlement run confirms it, and the money is not available meanwhile.
  </p>
  <form data-api="/api/transfers/external" data-result="#r-external" data-reload-on-success>
    <label>From<select name="from_account_id">
      <% accounts.forEach(a => { %><option value="<%= a.id %>"><%= a.kind %> <%= a.account_number %></option><% }) %>
    </select></label>
    <label>Sort code<input type="text" name="sort_code" placeholder="23-00-11" required></label>
    <label>Account number<input type="text" name="account_number" placeholder="60114477" required></label>
    <label>Amount in minor units<input type="number" name="amount_minor" placeholder="5000" required></label>
    <button type="submit">Send payment</button>
  </form>
  <pre id="r-external" class="result" hidden></pre>
</section>
</div>
<h2>Recent movements</h2>
<table><thead><tr><th>When</th><th>Detail</th><th>Status</th><th class="r">Amount</th></tr></thead><tbody>
<% recent.forEach(r => { %>
  <tr><td><%= r.created_at.toISOString().slice(0,10) %></td><td><%= r.narrative %></td>
  <td><% if (r.status === 'pending') { %><span class="pill">pending</span><% } else { %><span class="muted small">posted</span><% } %></td>
  <td class="r mono"><%= (r.amount_minor/100).toFixed(2) %> <%= r.currency %></td></tr>
<% }) %>
</tbody></table>
<%- include("partials/foot") %>
