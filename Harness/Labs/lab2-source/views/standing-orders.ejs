<%- include("partials/head") %>
<h1>Standing orders</h1>
<table><thead><tr><th>Payee</th><th>From</th><th>Frequency</th><th>Next</th><th class="r">Amount</th><th>Status</th></tr></thead><tbody>
<% orders.forEach(o => { %>
  <tr><td><%= o.display_name %> <span class="mono small"><%= o.payee_ref %></span></td>
  <td class="mono small"><%= o.account_number %></td><td><%= o.frequency %></td>
  <td><%= o.next_run.toISOString().slice(0,10) %></td>
  <td class="r mono"><%= o.display %></td>
  <td><% if (o.active) { %>active<% } else { %><span class="muted">cancelled</span><% } %></td></tr>
<% }) %>
</tbody></table>
<% if (!orders.length) { %><p class="muted">You have no standing orders.</p><% } %>
<%- include("partials/foot") %>
