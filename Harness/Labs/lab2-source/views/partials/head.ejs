<!doctype html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> · Brayford Mutual</title>
<link rel="stylesheet" href="/static/style.css">
<script src="/static/app.js" defer></script>
</head><body>
<header class="topbar">
  <a class="brand" href="/">Brayford<span>Mutual</span></a>
  <% if (customer) { %>
  <nav>
    <a href="/accounts">Accounts</a>
    <a href="/move-money">Move money</a>
    <a href="/payments">Bill payments</a>
    <a href="/standing-orders">Standing orders</a>
    <% if (customer.role === "business") { %><a href="/corporate">Corporate</a><% } %>
    <a href="/cards">Cards</a>
    <a href="/statements">Statements</a>
    <a href="/messages">Messages<% if (typeof unread !== "undefined" && unread) { %> <span class="badge"><%= unread %></span><% } %></a>
    <% if (["teller","ops","compliance","admin"].indexOf(customer.role) >= 0) { %><a href="/ops">Operations</a><% } %>
  </nav>
  <div class="who">
    <a href="/profile"><%= customer.full_name %></a>
    <a href="/signout">Sign out</a>
  </div>
  <% } else { %>
  <nav><a href="/signin">Sign in</a></nav>
  <% } %>
</header>
<main>
