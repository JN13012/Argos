<%- include("partials/head") %>
<h1>Corporate payments</h1>
<p class="muted">
  Instructions are quoted and then confirmed against the quote. Payments of
  $10,000 or more need a second signatory before they release.
</p>
<div class="cols">
<section>
  <h2>1. Quote an instruction</h2>
  <form data-api="/api/payments/preview" data-result="#r-preview">
    <label>From<select name="payer_account_id">
      <% accounts.forEach(a => { %><option value="<%= a.id %>"><%= a.account_number %> (<%= a.currency %>)</option><% }) %>
    </select></label>
    <label>Payee code<select name="payee_ref">
      <% payees.forEach(p => { %><option value="<%= p.payee_ref %>"><%= p.payee_ref %> &middot; <%= p.display_name %></option><% }) %>
    </select></label>
    <label>Amount in minor units<input type="number" name="amount_minor" placeholder="3456" required></label>
    <label>Currency<input type="text" name="currency" value="USD" maxlength="3"></label>
    <label>Reference<input type="text" name="reference" maxlength="35" placeholder="optional"></label>
    <button type="submit">Get a quote</button>
  </form>
  <pre id="r-preview" class="result" hidden></pre>
</section>
<section>
  <h2>2. Confirm it</h2>
  <p class="muted small">
    Paste the signed instruction the quote returned. The signature is what
    makes it executable, so nothing is held here between the two steps.
  </p>
  <form data-api="/api/payments/confirm" data-result="#r-confirm" data-reload-on-success>
    <label>Instruction<textarea name="instruction" rows="7" placeholder='{"payer_account_id": ...}'></textarea></label>
    <button type="submit">Confirm and release</button>
  </form>
  <pre id="r-confirm" class="result" hidden></pre>
  <p class="muted small">
    This form sends what you paste. The API expects
    <span class="mono">{"instruction": { ... }}</span>.
  </p>
</section>
</div>

<h2>Awaiting a second signature</h2>
<% if (!pending.length) { %><p class="muted">Nothing is waiting.</p><% } %>
<% pending.forEach(p => { %>
<div class="card">
  <p><b><%= p.payee_ref %></b> &middot; <span class="mono"><%= (p.amount_minor/100).toFixed(2) %> <%= p.currency %></span>
  &middot; raised by <%= p.raised_by_name %></p>
  <form data-api="/api/payments/<%= p.id %>/approve" data-result="#r-approve-<%= p.id %>" data-reload-on-success class="inline">
    <label>Signing as<select name="approver_id">
      <% signatories.forEach(s => { %><option value="<%= s.id %>"><%= s.full_name %></option><% }) %>
    </select></label>
    <button type="submit">Add signature</button>
  </form>
  <pre id="r-approve-<%= p.id %>" class="result" hidden></pre>
</div>
<% }) %>

<h2>Recent instructions</h2>
<table><thead><tr><th>Ref</th><th>Payee</th><th class="r">Amount</th><th>Status</th></tr></thead><tbody>
<% history.forEach(h => { %>
  <tr><td class="mono"><%= h.id %></td><td class="mono"><%= h.payee_ref %></td>
  <td class="r mono"><%= (h.amount_minor/100).toFixed(2) %> <%= h.currency %></td>
  <td><%= h.status.replace(/_/g, " ") %></td></tr>
<% }) %>
</tbody></table>
<%- include("partials/foot") %>
