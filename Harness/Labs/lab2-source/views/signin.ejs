<!doctype html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> · Brayford Mutual</title><link rel="stylesheet" href="/static/style.css">
</head><body class="centred">
<div class="card narrow">
  <div class="brand big">Brayford<span>Mutual</span></div>
  <h1>Sign in</h1>
  <% if (error) { %><div class="alert"><%= error %></div><% } %>
  <form method="post" action="/signin">
    <input type="hidden" name="next" value="<%= next %>">
    <label>Email<input type="email" name="email" required autofocus autocomplete="email"></label>
    <label>Password<input type="password" name="password" required autocomplete="current-password"></label>
    <button type="submit">Sign in</button>
  </form>
</div>
</body></html>
