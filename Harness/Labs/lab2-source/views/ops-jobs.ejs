<%- include("partials/head") %>
<h1>Batch schedule</h1>
<p class="muted">
  Jobs run one of the tasks that ship with the platform, each in its own
  process. Per job settings are passed to the task.
</p>
<table><thead><tr><th>Job</th><th>Task</th><th>Settings</th><th>Enabled</th><th>Last run</th><th></th></tr></thead><tbody>
<% jobs.forEach(j => { %>
  <tr>
    <td><%= j.name %></td>
    <td class="mono"><%= j.task %></td>
    <td class="mono small"><%= JSON.stringify(j.env) %></td>
    <td><%= j.enabled ? 'yes' : 'no' %></td>
    <td class="muted small"><%= j.last_run ? j.last_run.toISOString().slice(0,16).replace('T',' ') : 'never' %></td>
    <td>
      <form data-api="/api/ops/jobs/<%= j.id %>/run" data-result="#r-job<%= j.id %>" class="inline">
        <button class="tiny" type="submit">Run now</button>
      </form>
    </td>
  </tr>
  <tr><td colspan="6"><pre id="r-job<%= j.id %>" class="result" hidden></pre></td></tr>
<% }) %>
</tbody></table>

<div class="cols">
<section>
  <h2>Add a job</h2>
  <form data-api="/api/ops/jobs" data-result="#r-newjob" data-reload-on-success>
    <label>Name<input type="text" name="name" required></label>
    <label>Task<select name="task">
      <% tasks.forEach(t => { %><option value="<%= t %>"><%= t %></option><% }) %>
    </select></label>
    <label>Settings as JSON<textarea name="env" rows="3" placeholder='{"ANNUAL_RATE_BPS":"180"}'></textarea></label>
    <button type="submit">Create</button>
  </form>
  <pre id="r-newjob" class="result" hidden></pre>
  <p class="muted small">
    Settings are sent as a JSON object. The runner checks every value before
    it starts the task.
  </p>
</section>
<section>
  <h2>Recent runs</h2>
  <% runs.forEach(r => { %>
    <p class="muted small">
      <b><%= r.name %></b> &middot; exit <%= r.exit_code %> &middot;
      <%= r.started_at.toISOString().slice(0,16).replace('T',' ') %>
    </p>
    <pre class="result"><%= (r.output || '').slice(0, 600) %></pre>
  <% }) %>
  <% if (!runs.length) { %><p class="muted">No runs yet.</p><% } %>
</section>
</div>
<%- include("partials/foot") %>
