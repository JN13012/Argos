<%- include("partials/head") %>
<h1>Documents</h1>
<p class="muted">
  Identity documents and anything supporting a dispute. PDF, PNG or JPEG, up
  to 4MB.
</p>
<form method="post" action="/api/documents" enctype="multipart/form-data">
  <label>Kind<select name="kind">
    <option value="identity">Proof of identity</option>
    <option value="address">Proof of address</option>
    <option value="dispute">Dispute evidence</option>
  </select></label>
  <label>File<input type="file" name="document" required></label>
  <button type="submit">Upload</button>
</form>
<h2>Uploaded</h2>
<table><thead><tr><th>Name</th><th>Kind</th><th class="r">Size</th><th>When</th></tr></thead><tbody>
<% documents.forEach(d => { %>
  <tr><td><%= d.original_name %></td><td><%= d.kind %></td>
  <td class="r mono"><%= Math.round(d.byte_size/1024) %>KB</td>
  <td class="muted small"><%= d.created_at.toISOString().slice(0,10) %></td></tr>
<% }) %>
</tbody></table>
<% if (!documents.length) { %><p class="muted">Nothing uploaded yet.</p><% } %>
<%- include("partials/foot") %>
