<%- include("partials/head") %>
<h1>Bill payments</h1>
<p class="muted">Pay a registered biller. Same day, settles on the next run.</p>
<div class="cols">
<section>
  <h2>Pay a bill</h2>
  <form data-api="/api/billpay" data-result="#r-bill" data-reload-on-success>
    <label>From<select name="from_account_id">
      <% accounts.forEach(a => { %><option value="<%= a.id %>"><%= a.kind %> <%= a.account_number %></option><% }) %>
    </select></label>
    <label>Biller<select name="payee_id">
      <% billers.forEach(b => { %><option value="<%= b.id %>"><%= b.display_name %> (<%= b.payee_ref %>)</option><% }) %>
    </select></label>
    <label>Amount in minor units<input type="number" name="amount_minor" placeholder="7400" required></label>
    <button type="submit">Pay now</button>
  </form>
  <pre id="r-bill" class="result" hidden></pre>
</section>
<section>
  <h2>Your billers</h2>
  <table><thead><tr><th>Code</th><th>Name</th><th>Account</th></tr></thead><tbody>
  <% billers.forEach(b => { %>
    <tr><td class="mono"><%= b.payee_ref %></td><td><%= b.display_name %></td>
    <td class="mono small"><%= b.sort_code %> <%= b.account_number %></td></tr>
  <% }) %>
  </tbody></table>
  <p class="muted small"><a href="/payees">Manage payees</a></p>
</section>
</div>
<%- include("partials/foot") %>
