<%- include("partials/head") %>
<h1>Card transactions</h1>
<p class="muted">
  Foreign purchases show what the merchant charged and what it settled at
  against your account.
</p>
<table><thead><tr><th>Date</th><th>Merchant</th><th class="r">Charged</th><th class="r">Billed</th><th></th></tr></thead><tbody>
<% txns.forEach(t => { %>
  <tr>
    <td><%= t.posted_at.toISOString().slice(0,10) %></td>
    <td><%= t.merchant %></td>
    <td class="r mono"><%= t.charged %></td>
    <td class="r mono"><%= t.billed %></td>
    <td>
      <% if (t.open_disputes) { %><span class="pill">disputed</span><% } else { %>
      <form data-api="/api/disputes" data-result="#r-d<%= t.id %>" data-reload-on-success class="inline">
        <input type="hidden" name="transaction_id" value="<%= t.id %>">
        <input type="text" name="reason" placeholder="reason" required>
        <input type="number" name="claimed_minor" placeholder="amount" required>
        <button class="tiny" type="submit">Dispute</button>
      </form>
      <pre id="r-d<%= t.id %>" class="result" hidden></pre>
      <% } %>
    </td>
  </tr>
<% }) %>
</tbody></table>
<h2>Your disputes</h2>
<% if (!disputes.length) { %><p class="muted">You have not raised any.</p><% } %>
<table><thead><tr><th>Merchant</th><th>Reason</th><th class="r">Claimed</th><th>Status</th></tr></thead><tbody>
<% disputes.forEach(d => { %>
  <tr><td><%= d.merchant %></td><td><%= d.reason %></td>
  <td class="r mono"><%= d.claimed_minor %></td><td><%= d.status %></td></tr>
<% }) %>
</tbody></table>
<%- include("partials/foot") %>
