<%- include("partials/head") %>
<h1>Operations</h1>
<p class="muted">
  Back office tooling. <a href="/ops/jobs">Batch schedule</a> &middot;
  <a href="/ops/customers">Customers</a>
</p>
<h2>Open holds</h2>
<p class="muted small">
  A hold reduces what a customer can spend without being a ledger entry.
  Releasing one puts the money straight back.
</p>
<table><thead><tr><th>Hold</th><th>Account</th><th>Reason</th><th class="r">Amount</th><th></th></tr></thead><tbody>
<% holds.forEach(h => { %>
  <tr><td class="mono"><%= h.id %></td><td class="mono"><%= h.account_number %></td>
  <td><%= h.reason %></td><td class="r mono"><%= (h.amount_minor/100).toFixed(2) %></td>
  <td>
    <form data-api="/api/ops/holds/<%= h.id %>/release" data-result="#r-h<%= h.id %>" data-reload-on-success class="inline">
      <button class="tiny" type="submit">Release</button>
    </form>
  </td></tr>
<% }) %>
</tbody></table>
<% if (!holds.length) { %><p class="muted">No open holds.</p><% } %>
<h2>Batch schedule</h2>
<table><thead><tr><th>Job</th><th>Task</th><th>Enabled</th></tr></thead><tbody>
<% jobs.forEach(j => { %>
  <tr><td><%= j.name %></td><td class="mono"><%= j.task %></td><td><%= j.enabled ? 'yes' : 'no' %></td></tr>
<% }) %>
</tbody></table>
<%- include("partials/foot") %>
