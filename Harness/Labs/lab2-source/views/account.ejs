<%- include("partials/head") %>
<h1><%= account.kind %> <span class="mono"><%= account.account_number %></span></h1>
<dl class="tight wide">
  <dt>Available to spend</dt><dd class="amount"><%= available_display %></dd>
  <dt>Ledger balance</dt><dd><%= posted_display %></dd>
  <dt>Arranged overdraft</dt><dd><%= overdraft_display %></dd>
  <dt>Sort code</dt><dd class="mono"><%= account.sort_code %></dd>
</dl>
<h2>Recent activity</h2>
<table><thead><tr><th>Date</th><th>Detail</th><th>Status</th><th class="r">Amount</th></tr></thead><tbody>
<% entries.forEach(e => { %>
  <tr><td><%= e.value_date.toISOString().slice(0,10) %></td>
  <td><%= e.narrative %></td>
  <td><% if (e.status === 'pending') { %><span class="pill">pending</span><% } else { %><span class="muted small">posted</span><% } %></td>
  <td class="r mono"><%= e.display %></td></tr>
<% }) %>
</tbody></table>
<%- include("partials/foot") %>
