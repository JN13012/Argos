{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(curl:*)",
      "Bash(httpx:*)",
      "Bash(ffuf:*)",
      "Bash(nuclei:*)",
      "Bash(jq:*)",
      "Read(./**)",
      "WebSearch",
      "mcp__burp__get_proxy_http_history",
      "mcp__burp__send_http_request"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(git push:*)",

      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(node:*)",
      "Bash(ruby:*)",
      "Bash(perl:*)",
      "Bash(php:*)",
      "Bash(sh:*)",
      "Bash(bash:*)",
      "Bash(zsh:*)",
      "Bash(xargs:*)",
      "Bash(env:*)",
      "Bash(printenv:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(ncat:*)",
      "Bash(socat:*)",
      "Bash(ssh:*)",

      "WebFetch",

      "Read(//proc/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.env)",
      "Read(**/credentials*)",
      "Read(**/*credentials*)",
      "Read(**/.auth/**)",
      "Read(**/.aws/**)",
      "Read(~/.aws/**)",
      "Read(**/.azure/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gcloud/**)",
      "Read(**/.kube/config)",
      "Read(~/.kube/config)",
      "Read(**/.docker/config.json)",
      "Read(~/.docker/config.json)",
      "Read(**/.ssh/**)",
      "Read(~/.ssh/**)",
      "Read(**/.netrc)",
      "Read(~/.netrc)",
      "Read(**/.git-credentials)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Read(**/.claude/.credentials.json)",
      "Read(~/.claude/.credentials.json)",
      "Read(**/*token*.json)",
      "Read(**/*.token)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",

      "Edit(./scope.md)",
      "Write(./scope.md)",
      "Edit(./CLAUDE.md)",
      "Edit(./.claude/**)",
      "Write(./.claude/**)",
      "Edit(**/.env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": ".claude/hooks/scope-check.sh" }] }
    ]
  }
}
