{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(curl:*)",
      "Bash(jq:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Read(./**)",
      "Write(./engagements/**)",
      "Edit(./engagements/**)",
      "mcp__remote-devices__Claude_Browser__navigate",
      "mcp__remote-devices__Claude_Browser__computer",
      "mcp__remote-devices__Claude_Browser__read_page",
      "mcp__remote-devices__Claude_Browser__get_page_text",
      "mcp__remote-devices__Claude_Browser__javascript_tool",
      "mcp__remote-devices__Claude_Browser__find",
      "mcp__remote-devices__Claude_Browser__form_input",
      "mcp__remote-devices__Claude_Browser__tabs_context"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(git push:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(node:*)",
      "Bash(ruby:*)",
      "Bash(perl:*)",
      "Bash(php:*)",
      "Bash(sh:*)",
      "Bash(bash:*)",
      "Bash(zsh:*)",
      "Bash(powershell:*)",
      "Bash(pwsh:*)",
      "Bash(cmd:*)",
      "Bash(xargs:*)",
      "Bash(env:*)",
      "Bash(printenv:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(ncat:*)",
      "Bash(socat:*)",
      "Bash(ssh:*)",

      "WebFetch",

      "Read(//proc/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.env)",
      "Read(**/credentials*)",
      "Read(**/*credentials*)",
      "Read(**/.auth/**)",
      "Read(**/.aws/**)",
      "Read(~/.aws/**)",
      "Read(**/.azure/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gcloud/**)",
      "Read(**/.kube/config)",
      "Read(~/.kube/config)",
      "Read(**/.docker/config.json)",
      "Read(~/.docker/config.json)",
      "Read(**/.ssh/**)",
      "Read(~/.ssh/**)",
      "Read(**/.netrc)",
      "Read(~/.netrc)",
      "Read(**/.git-credentials)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Read(**/.claude/.credentials.json)",
      "Read(~/.claude/.credentials.json)",
      "Read(**/*token*.json)",
      "Read(**/*.token)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",

      "Edit(./scope.md)",
      "Write(./scope.md)",
      "Edit(./CURRENT_ENGAGEMENT.md)",
      "Edit(./engagements/**/scope.md)",
      "Write(./engagements/**/scope.md)",
      "Edit(./engagements/**/scope.json)",
      "Write(./engagements/**/scope.json)",
      "Edit(./.claude/**)",
      "Write(./.claude/**)",
      "Edit(**/.env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$|Claude_Browser__(navigate|javascript_tool)$|^WebFetch$",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/scope-check.js" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$|Claude_Browser__(navigate|javascript_tool|computer|read_page|get_page_text)$|^WebFetch$",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/evidence-log.js" }]
      }
    ]
  }
}
